{
  "$schema": "https://chickensoft.games/schemas/addons.schema.json",
  "addons": {
    // Install this repo into the hidden workbench the same way a consumer does.
    "aerobeat-tool-camera-gesture-control": {
      "url": "..",
      "source": "symlink",
      "subfolder": "/"
    },
    // Shared tool/workflow baseline for tool-lane packages.
    "aerobeat-tool-core": {
      "url": "git@github.com:AeroBeat-Workouts/aerobeat-tool-core.git",
      "checkout": "main",
      "subfolder": "/"
    },
    // Vendor-neutral tracking boundary consumed directly by repo-root src and the hidden proving stack.
    "aerobeat-tool-camera-tracking": {
      "url": "../../aerobeat-tool-camera-tracking",
      "source": "symlink",
      "subfolder": "/"
    },
    // Real MediaPipe backend for truthful CameraTracking proving inside the hidden testbed only.
    "aerobeat-vendor-mediapipe-python": {
      "url": "git@github.com:AeroBeat-Workouts/aerobeat-vendor-mediapipe-python.git",
      "checkout": "main",
      "subfolder": "/"
    },
    // Playback facade for repo-owned replay preview wiring inside the hidden testbed.
    "aerobeat-tool-video-player": {
      "url": "git@github.com:AeroBeat-Workouts/aerobeat-tool-video-player.git",
      "checkout": "main",
      "subfolder": "/"
    },
    // Concrete Godot playback backend injected behind the repo-owned video-player facade.
    "aerobeat-vendor-godot-video": {
      "url": "git@github.com:AeroBeat-Workouts/aerobeat-vendor-godot-video.git",
      "checkout": "main",
      "subfolder": "/"
    },
    // Dev-only headless quit listener used for approved headless runs.
    "aerobeat-tool-headless-manager": {
      "url": "git@github.com:AeroBeat-Workouts/aerobeat-tool-headless-manager.git",
      "checkout": "main",
      "subfolder": "/"
    },
    // GUT drives repo-local validation inside the hidden testbed/workbench.
    "gut": {
      "url": "git@github.com:bitwes/Gut.git",
      "checkout": "main",
      "subfolder": "/addons/gut"
    }
  }
}
