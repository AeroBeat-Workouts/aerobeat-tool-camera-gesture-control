; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="AeroBeat Tool Camera Gesture Control Testbed"
run/main_scene="res://scenes/camera_gesture_testbed.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")

[autoload]

AeroHeadlessManager="*res://addons/aerobeat-tool-headless-manager/src/AeroHeadlessManager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[editor_plugins]

enabled=PackedStringArray("res://addons/aerobeat-vendor-godot-unit-test/plugin.cfg")
